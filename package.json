{
  "name": "dsh-btw",
  "version": "0.0.3",
  "description": "Side questions (/btw) and ephemeral temporary chat for DeepSeek Harness (dsh) — ask without interrupting the main agent, dispose without traces",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node --check lib/index.js && node --check lib/client.js",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Night-Vision/dsh-btw-desktop.git"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=1.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "btw",
    "side-question",
    "temporary-chat"
  ],
  "license": "MIT",
  "author": "iluluyu"
}
